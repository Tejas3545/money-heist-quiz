# Upstash Redis (REST) - Console > your database > REST API
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# Initial game code everyone types in (can be changed later from the admin panel)
GAME_CODE=VAULT36

# Admin panel password
ADMIN_PASSWORD=change-this-long-password

# Secret slugs (no leading slash). Pick long random strings.
# Admin panel  -> https://YOUR-SITE/<ADMIN_PATH>
# Projector    -> https://YOUR-SITE/<SCREEN_PATH>
ADMIN_PATH=hq-replace-with-random-string
SCREEN_PATH=screen-replace-with-random-string

# 32+ random characters. Signs player and admin sessions. Changing it logs everyone out
# and changes every player ID, so never change it during the event.
SESSION_SECRET=replace-with-at-least-32-random-characters
